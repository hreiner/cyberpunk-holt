  "panels": [
    {
      "id": "p07-c01",
      "label": "Case 1 — Le parking",
      "rect": [
        0.01171875,
        0.0078125,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 6,
      "cues": [
        {
          "id": "bp-l032",
          "globalLine": 32,
          "speaker": "wendy",
          "textFr": "Vous quatre, attendez ici.",
          "textEn": "You four, wait here.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/prepared/32-wendy-gain-+4.5db.wav",
          "duration": 1.92,
          "ttsText": "[quiet, commanding] You four, wait here.",
          "ttsModel": "eleven_v4",
          "performance": "Consigne précise à John, Abigail, Grover et enfant avant parking, Franklyn l'accompagne.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/32-wendy-ed9fbed455bc.json"
        },
        {
          "id": "bp-l033",
          "globalLine": 33,
          "speaker": "john",
          "textFr": "Et s'ils demandent les clés ?",
          "textEn": "What if they ask for the keys?",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/prepared/33-john-gain-+4.6db.wav",
          "duration": 2,
          "ttsText": "[skeptical, low] What if they ask for the keys?",
          "ttsModel": "eleven_v4",
          "performance": "Friction du bluff ; John doute du plan, pas une plaisanterie de héros.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/33-john-415d326fcbdc.json"
        }
      ]
    },
    {
      "id": "p07-c02",
      "label": "Case 2 — Le bluff",
      "rect": [
        0.01171875,
        0.3385416666666667,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 6.5,
      "cues": [
        {
          "id": "bp-l019",
          "globalLine": 19,
          "speaker": "wendy",
          "textFr": "Notre voiture est à l'intérieur. On s'en va.",
          "textEn": "Our car's inside. We're leaving.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/19-wendy-d35d721ed22f.mp3",
          "duration": 2.64,
          "ttsText": "[confident, matter-of-fact] Our car's inside. [impatient, controlled] We're leaving.",
          "ttsModel": "eleven_v4",
          "performance": "Bluff sans panique : assurance empruntée puis petite impatience crédible.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/19-wendy-d35d721ed22f.json"
        },
        {
          "id": "bp-l020",
          "globalLine": 20,
          "speaker": "franklyn",
          "textFr": "On n'en a pas pour longtemps.",
          "textEn": "We won't be long.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/20-franklyn-33d59949d7fb.mp3",
          "duration": 1.52,
          "ttsText": "[restrained, trying to sound casual] We won't be long.",
          "ttsModel": "eleven_v4",
          "performance": "Il aide le bluff malgré la fatigue ; mâchoire tendue et voix tenue, aucune désinvolture triomphante.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/20-franklyn-33d59949d7fb.json"
        }
      ]
    },
    {
      "id": "p07-c03",
      "label": "Case 3 — Le volant",
      "rect": [
        0.01171875,
        0.6692708333333334,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 5.5,
      "cues": [
        {
          "id": "bp-l034",
          "globalLine": 34,
          "speaker": "wendy",
          "textFr": "Tu prends le volant.",
          "textEn": "You're driving.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/34-wendy-01cf70d183b9.mp3",
          "duration": 1.36,
          "ttsText": "[matter-of-fact, firm] You're driving.",
          "ttsModel": "eleven_v4",
          "performance": "À Franklyn seulement une fois les gardiens dépassés ; pas à portée du poste.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/34-wendy-01cf70d183b9.json"
        },
        {
          "id": "bp-l035",
          "globalLine": 35,
          "speaker": "franklyn",
          "textFr": "Tu me fais confiance ?",
          "textEn": "You trust me?",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/35-franklyn-bf77cf2d9604.mp3",
          "duration": 1.84,
          "ttsText": "[uneasy, questioning] You trust me?",
          "ttsModel": "eleven_v4",
          "performance": "Doute concret et tension résiduelle ; il accepte d'aider, pas un retour triomphant à l'expert.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/35-franklyn-bf77cf2d9604.json"
        }
      ]
