  "panels": [
    {
      "id": "p05-c01",
      "label": "Case 1 — Le signe",
      "rect": [
        0.01171875,
        0.0078125,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 4,
      "cues": [
        {
          "id": "bp-l024",
          "globalLine": 24,
          "speaker": "john",
          "textFr": "Ça ne me plaît pas.",
          "textEn": "I don't like this.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/prepared/24-john-gain-+3.2db.wav",
          "duration": 1.68,
          "ttsText": "[low, wary] I don't like this.",
          "ttsModel": "eleven_v4",
          "performance": "Pressentiment adressé au groupe ; dur et méfiant, sans soupir.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/24-john-88d66c35f225.json"
        }
      ]
    },
    {
      "id": "p05-c02",
      "label": "Case 2 — Les fenêtres",
      "rect": [
        0.01171875,
        0.3385416666666667,
        0.482421875,
        0.3229166666666667
      ],
      "holdSeconds": 4,
      "cues": [
        {
          "id": "bp-l016",
          "globalLine": 16,
          "speaker": "wendy",
          "textFr": "Éloignez-vous des fenêtres. Tout de suite.",
          "textEn": "Away from the windows. Now.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/16-wendy-cdc9a2eb5cf4.mp3",
          "duration": 2.24,
          "ttsText": "[urgent, low and firm] Away from the windows. [sharp] Now.",
          "ttsModel": "eleven_v4",
          "performance": "Ordre net et protecteur ; la seconde phrase coupe la sidération, sans hurler.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/16-wendy-cdc9a2eb5cf4.json"
        }
      ]
    },
    {
      "id": "p05-c03",
      "label": "Case 3 — John frappe",
      "rect": [
        0.505859375,
        0.3385416666666667,
        0.482421875,
        0.3229166666666667
      ],
      "holdSeconds": 6,
      "cues": [
        {
          "id": "bp-l025",
          "globalLine": 25,
          "speaker": "john",
          "textFr": "Pose ça.",
          "textEn": "Put it down.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/prepared/25-john-gain--0.4db.wav",
          "duration": 1.36,
          "gapSeconds": 0.75,
          "ttsText": "[stern, warning] Put it down.",
          "ttsModel": "eleven_v4",
          "performance": "Sommation courte adressée au barman AVANT le coup ; ce n'est pas une réplique après KO.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/25-john-6a27bdb3fbef.json"
        },
        {
          "id": "bp-l026",
          "globalLine": 26,
          "speaker": "grover",
          "textFr": "John ! Ça suffit !",
          "textEn": "John! That's enough!",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/26-grover-26cbc3af691c.mp3",
          "duration": 1.68,
          "ttsText": "[urgent, sharp] John! That's enough!",
          "ttsModel": "eleven_v4",
          "performance": "Grover coupe l'élan APRÈS un seul coup, pour repartir ; ne pas suggérer une série de coups.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/26-grover-26cbc3af691c.json"
        }
      ]
    },
    {
      "id": "p05-c04",
      "label": "Case 4 — Le tir",
      "rect": [
        0.01171875,
        0.6692708333333334,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 4.5,
      "cues": [
        {
          "id": "bp-l027",
          "globalLine": 27,
          "speaker": "franklyn",
          "textFr": "Abigail ! Le petit !",
          "textEn": "Abigail! The kid!",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/27-franklyn-65014b904364.mp3",
          "duration": 1.68,
          "ttsText": "[shouts, alarmed] Abigail! The kid!",
          "ttsModel": "eleven_v4",
          "performance": "Franklyn se remet au service du groupe malgré son choc ; appelle Abigail à protéger l'enfant.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/27-franklyn-65014b904364.json"
        },
        {
          "id": "bp-l017",
          "globalLine": 17,
          "speaker": "abigail",
          "textFr": "À terre !",
          "textEn": "Down!",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/17-abigail-3d61c3f2b3fd.mp3",
          "duration": 0.96,
          "ttsText": "[shouts, frightened] Down!",
          "ttsModel": "eleven_v4",
          "performance": "Cri réflexe pour protéger l'enfant ; bref, sans souffle ajouté.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/17-abigail-3d61c3f2b3fd.json"
        }
      ],
