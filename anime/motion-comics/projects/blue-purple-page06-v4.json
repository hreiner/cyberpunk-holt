  "panels": [
    {
      "id": "p06-c01",
      "label": "Case 1 — Le poursuivant recule",
      "rect": [
        0.01171875,
        0.0078125,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 3,
      "cues": [
        {
          "id": "bp-l028",
          "globalLine": 28,
          "speaker": "john",
          "textFr": "On le suit ?",
          "textEn": "Do we go after him?",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/28-john-c900ce4b8a69.mp3",
          "duration": 1.44,
          "ttsText": "[tense, questioning] Do we go after him?",
          "ttsModel": "eleven_v4",
          "performance": "Encore dans l'action, John demande une décision ; il ne se lance pas en poursuite.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/28-john-c900ce4b8a69.json"
        }
      ]
    },
    {
      "id": "p06-c02",
      "label": "Case 2 — Éviter les caméras",
      "rect": [
        0.01171875,
        0.3385416666666667,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 8,
      "cues": [
        {
          "id": "bp-l029",
          "globalLine": 29,
          "speaker": "wendy",
          "textFr": "Non. On disparaît.",
          "textEn": "No. We disappear.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/29-wendy-dbb700141231.mp3",
          "duration": 2.16,
          "ttsText": "[firm, decisive] No. We disappear.",
          "ttsModel": "eleven_v4",
          "performance": "Wendy refuse une escalade et enchaîne immédiatement avec caméras/ruelle.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/29-wendy-dbb700141231.json"
        },
        {
          "id": "bp-l018",
          "globalLine": 18,
          "speaker": "wendy",
          "textFr": "Pas de foule. Les caméras nous retrouveraient. Par la ruelle.",
          "textEn": "No crowds. The cameras will find us. Back alley.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/18-wendy-39b9935a631d.mp3",
          "duration": 4.16,
          "ttsText": "[firm, controlled urgency] No crowds. [low, warning] The cameras will find us. [decisive] Back alley.",
          "ttsModel": "eleven_v4",
          "performance": "Elle interdit la facilité apparente puis donne une issue concrète, voix basse retrouvée.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-01-08/audio-v1/takes/18-wendy-39b9935a631d.json"
        }
      ]
    },
    {
      "id": "p06-c03",
      "label": "Case 3 — Tous les six",
      "rect": [
        0.01171875,
        0.6692708333333334,
        0.9765625,
        0.3229166666666667
      ],
      "holdSeconds": 5.5,
      "cues": [
        {
          "id": "bp-l030",
          "globalLine": 30,
          "speaker": "abigail",
          "textFr": "On est tous là ?",
          "textEn": "Are we all here?",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/prepared/30-abigail-gain-+10.4db.wav",
          "duration": 1.52,
          "ttsText": "[worried, quietly] Are we all here?",
          "ttsModel": "eleven_v4",
          "performance": "Vérification anxieuse adressée au groupe pendant sortie ; ne pas prononcer un compte robotique.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/30-abigail-3891ff5d85ca.json"
        },
        {
          "id": "bp-l031",
          "globalLine": 31,
          "speaker": "grover",
          "textFr": "Tous les six. Avance.",
          "textEn": "All six. Keep moving.",
          "audio": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/31-grover-4b193abfb1e8.mp3",
          "duration": 1.76,
          "ttsText": "[quick, reassuring] All six. [urgent] Keep moving.",
          "ttsModel": "eleven_v4",
          "performance": "Rassure brièvement Abigail puis relance la fuite ; aucune allégresse.",
          "takeJournal": "../../../art-masters/motion-comics/blue-purple/pages-05-08/revision-01/audio-v1/takes/31-grover-4b193abfb1e8.json"
        }
      ]
    }
