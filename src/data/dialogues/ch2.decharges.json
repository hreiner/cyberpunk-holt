    "garde-dort-franklyn": {
      "text": "Franklyn n'a pas pris de tour, cette nuit. Personne ne le lui reproche : en manque comme il est, mieux vaut le savoir reposé pour demain.",
      "to": "fin"
    },
    "garde-dort-john": {
      "text": "John n'a pas veillé, cette nuit. Il en aurait pris un de plus s'il avait fallu -- ce n'était pas nécessaire.",
      "to": "fin"
    },
    "garde-dort-grover": {
      "text": "Grover a dormi toute la nuit, sans un mot. Les autres s'en sont chargés.",
      "to": "fin"
    },
    "garde-dort-abigail": {
      "text": "Abigail a dormi toute la nuit. Personne n'a insisté pour qu'elle prenne un tour.",
      "to": "fin"
    },
