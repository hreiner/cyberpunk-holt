{
  "id": "ch2.decharges",
  "backdrop": "decharges",
  "start": "trajet",
  "nodes": {
    "trajet": {
      "text": "Des heures de piste dans le noir, entassés dans le camion volé. Letitia gémit à chaque cahot. Puis une lueur monte à l'horizon, grandit, dévore le ciel : Night City. Les tours, les néons, la ville dont ils parlaient tous les soirs au dortoir. Ils devaient y entrer en uniforme, le diplôme en poche. Pas comme ça. Pas avec du sang sur les mains.",
      "to": "arrivee"
    },
    "arrivee": {
      "text": "Les décharges, à la lisière de la ville. Le camion de Murano tousse une dernière fois et s'arrête, à sec, entre deux montagnes de ferraille. Le fusil est posé en travers des genoux de John. Personne ne descend tout de suite. Plus d'académie, plus d'instructeurs, plus d'ordres à suivre : rien qu'une ville immense qui ne sait même pas qu'ils existent.",
      "choices": [
        {
          "text": "Continuer.",
          "conditions": [{ "tag": "vu-simulation" }, { "not": { "flag": "ch2.bal.john.fait", "equals": true } }],
          "to": "rendezvous-confirme"
        },
        {
          "text": "Continuer.",
          "conditions": [
            { "not": { "tag": "vu-simulation" } },
            { "not": { "flag": "ch2.bal.john.fait", "equals": true } }
          ],
          "to": "rendezvous-nouveau"
        },
        {
          "text": "Continuer.",
          "conditions": [{ "tag": "vu-simulation" }, { "flag": "ch2.bal.john.fait", "equals": true }],
          "to": "rendezvous-confirme-avance"
        },
        {
          "text": "Continuer.",
          "conditions": [
            { "not": { "tag": "vu-simulation" } },
            { "flag": "ch2.bal.john.fait", "equals": true }
          ],
          "to": "rendezvous-nouveau-avance"
        }
      ]
    },
    "rendezvous-confirme": {
      "text": "John attend déjà, adossé à la carcasse d'une camionnette. « Smith t'a trouvé toi aussi ? Elle m'a donné un endroit, pour demain. »",
      "to": "gangs"
    },
    "rendezvous-nouveau": {
      "text": "John attend, adossé à la carcasse d'une camionnette. « J'ai un endroit pour demain. On y sera. »",
      "to": "gangs"
    },
    "rendezvous-confirme-avance": {
      "text": "John parle du rendez-vous avant même que Franklyn ouvre la bouche : « Smith t'a trouvé toi aussi, hein ? Je sais déjà où — pour demain. »",
      "to": "gangs"
    },
    "rendezvous-nouveau-avance": {
      "text": "John devance la question, comme au bal : « J'ai déjà un endroit pour demain. Je voulais te le dire avant que tu demandes. »",
      "to": "gangs"
    },
    "gangs": {
      "text": "Des gamins sortent des tas de ferraille, l'œil sur le fusil. Leur demander un coup de main ne mène nulle part — ils ne veulent qu'une chose.",
      "choices": [
        {
          "text": "Continuer.",
          "conditions": [
            {
              "tag": "a-tue"
            }
          ],
          "to": "gangs-froid"
        },
        {
          "text": "[Persuasion] Tenir tête, la dernière cartouche dans la chambre.",
          "conditions": [
            { "not": { "tag": "a-tue" } },
            { "flag": "ch2.fusil.charge", "equals": true }
          ],
          "check": { "skill": "persuasion", "dv": "NORMALE" },
          "onSuccess": "gangs-calmes",
          "onFailure": "gangs-rodent"
        },
        {
          "text": "Tirer la dernière cartouche en l'air.",
          "conditions": [
            { "not": { "tag": "a-tue" } },
            { "flag": "ch2.fusil.charge", "equals": true }
          ],
          "to": "gangs-tir"
        },
        {
          "text": "[Bluff] Braquer le fusil vide, sans ciller.",
          "conditions": [
            {
              "not": {
                "tag": "a-tue"
              }
            },
            { "not": { "flag": "ch2.fusil.charge", "equals": true } },
            {
              "tag": "bluffeur"
            }
          ],
          "check": {
            "skill": "persuasion",
            "dv": "NORMALE"
          },
          "onSuccess": "gangs-calmes",
          "onFailure": "gangs-rodent"
        },
        {
          "text": "[Persuasion] Tenir tête, le fusil vide braqué.",
          "conditions": [
            {
              "not": {
                "tag": "a-tue"
              }
            },
            { "not": { "flag": "ch2.fusil.charge", "equals": true } },
            {
              "not": {
                "tag": "bluffeur"
              }
            }
          ],
          "check": {
            "skill": "persuasion",
            "dv": "DIFFICILE"
          },
          "onSuccess": "gangs-calmes",
          "onFailure": "gangs-rodent"
        }
      ]
    },
    "gangs-tir": {
      "text": "La détonation claque sur la ferraille. Les gamins détalent. Ils ne reviendront pas de sitôt — mais le fusil, maintenant, est vide.",
      "sound": { "sfx": ["shot"] },
      "effects": [
        { "flag": "ch2.fusil.charge", "value": false },
        {
          "entry": {
            "key": "ch2.fusil",
            "label": "Le fusil",
            "value": "celui de Murano, vide : la dernière cartouche tirée en l'air aux décharges"
          }
        }
      ],
      "to": "garde-intro"
    },
    "gangs-calmes": {
      "text": "Ils reculent, sans un mot de plus, et se fondent dans le noir.",
      "to": "garde-intro"
    },
    "gangs-rodent": {
      "text": "Ils ne reculent pas vraiment. Ils rôdent, un peu plus loin, dans le noir — ils reviendront.",
      "effects": [
        {
          "counter": "ch2.decharges.gangs-dv",
          "delta": 1
        }
      ],
      "to": "garde-intro"
    },
    "gangs-froid": {
      "text": "Un regard suffit. Ils reconnaissent quelque chose dans ses yeux, et reculent sans discuter.",
      "to": "garde-intro"
    },
    "garde-intro": {
      "text": "La nuit à tenir, avant le jour. Au loin, la ville ne dort pas : des sirènes, des moteurs, des cris qui ne s'adressent à personne. Ici, ils ne sont plus des cadets. Juste des gamins dans la ferraille, sans nom ni adresse. Quelqu'un doit veiller sur la voiture — et sur Letitia.",
      "choices": [
        {
          "text": "Organiser des tours de garde.",
          "to": "garde-tour"
        },
        {
          "text": "Laisser tout le monde dormir.",
          "to": "garde-dormir"
        }
      ]
    },
    "garde-dormir": {
      "text": "Personne ne veille. Au matin, la voiture est vide, dépouillée jusqu'aux sièges — mais tout le monde a dormi, pour de bon.",
      "effects": [
        {
          "tag": "voiture-pillee"
        },
        {
          "flag": "ch2.decharges.repos",
          "value": true
        }
      ],
      "to": "fin"
    },
    "fin": {
      "choices": [
        {
          "text": "Continuer.",
          "conditions": [
            {
              "tag": "enfant-confiance"
            },
            {
              "not": {
                "flag": "ch2.enfant.lien",
                "equals": "franklyn"
