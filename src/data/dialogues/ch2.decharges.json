{
  "id": "ch2.decharges",
  "backdrop": "decharges",
  "start": "arrivee",
  "nodes": {
    "arrivee": {
      "text": "Les décharges, à la lisière de Night City. Une voiture abandonnée, portière ouverte ; dans le coffre, un fusil, vide.",
      "effects": [
        {
          "entry": {
            "key": "ch2.fusil",
            "label": "Le fusil",
            "value": "vide, récupéré à la décharge"
          }
        }
      ],
      "choices": [
        {
          "text": "Continuer.",
          "conditions": [
            {
              "tag": "vu-simulation"
            }
          ],
          "to": "rendezvous-confirme"
        },
        {
          "text": "Continuer.",
          "conditions": [
            {
              "not": {
                "tag": "vu-simulation"
              }
            }
          ],
          "to": "rendezvous-nouveau"
        }
      ]
    },
    "rendezvous-confirme": {
      "text": "John attend déjà, adossé à la carcasse d'une camionnette. « Smith t'a trouvé toi aussi ? Elle m'a donné un endroit, pour demain. »",
      "to": "gangs"
    },
    "rendezvous-nouveau": {
      "text": "John attend, adossé à la carcasse d'une camionnette. « J'ai un endroit pour demain. On y sera. »",
      "to": "gangs"
    },
    "gangs": {
      "text": "Des gamins sortent des tas de ferraille, l'œil sur le fusil. Leur demander un coup de main ne mène nulle part — ils ne veulent qu'une chose.",
      "choices": [
        {
          "text": "Continuer.",
          "conditions": [
            {
              "tag": "a-tue"
            }
          ],
          "to": "gangs-froid"
        },
        {
          "text": "[Bluff] Braquer le fusil vide, sans ciller.",
          "conditions": [
            {
              "not": {
                "tag": "a-tue"
              }
            },
            {
              "tag": "bluffeur"
            }
          ],
          "check": {
            "skill": "persuasion",
            "dv": "NORMALE"
          },
          "onSuccess": "gangs-calmes",
          "onFailure": "gangs-rodent"
        },
        {
          "text": "[Persuasion] Tenir tête, le fusil vide braqué.",
          "conditions": [
            {
              "not": {
                "tag": "a-tue"
              }
            },
            {
              "not": {
                "tag": "bluffeur"
              }
            }
          ],
          "check": {
            "skill": "persuasion",
            "dv": "DIFFICILE"
          },
          "onSuccess": "gangs-calmes",
          "onFailure": "gangs-rodent"
        }
      ]
    },
    "gangs-calmes": {
      "text": "Ils reculent, sans un mot de plus, et se fondent dans le noir.",
      "to": "garde-intro"
    },
    "gangs-rodent": {
      "text": "Ils ne reculent pas vraiment. Ils rôdent, un peu plus loin, dans le noir — ils reviendront.",
      "effects": [
        {
          "counter": "ch2.decharges.gangs-dv",
          "delta": 1
        }
      ],
      "to": "garde-intro"
    },
    "gangs-froid": {
      "text": "Un regard suffit. Ils reconnaissent quelque chose dans ses yeux, et reculent sans discuter.",
      "to": "garde-intro"
    },
    "garde-intro": {
      "text": "La nuit à tenir, avant le jour. Quelqu'un doit veiller sur la voiture — et sur Letitia.",
      "choices": [
        {
          "text": "Organiser des tours de garde.",
          "to": "garde-tour"
        },
        {
          "text": "Laisser tout le monde dormir.",
          "to": "garde-dormir"
        }
      ]
    },
    "garde-dormir": {
      "text": "Personne ne veille. Au matin, la voiture est vide, dépouillée jusqu'aux sièges — mais tout le monde a dormi, pour de bon.",
      "effects": [
        {
          "tag": "voiture-pillee"
        },
        {
          "flag": "ch2.decharges.repos",
          "value": true
        }
      ],
      "to": "fin"
    },
    "fin": {
      "text": "Le ciel pâlit à l'est. La nuit est tenue, d'une manière ou d'une autre — il faut repartir, trouver quelqu'un pour soigner Letitia."
    },
